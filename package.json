{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "nuxt build",
    "build:analyze": "ANALYZE=true nuxt build",
    "dev": "nuxt dev",
    "dev:fast": "nuxt dev --port 3000 --hostname 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "rm -rf .nuxt .output node_modules/.cache",
    "type-check": "nuxt typecheck",
    "check-players": "node scripts/check-players.mjs",
    "build:app": "APP_TARGET=ios nuxt generate",
    "cap:sync": "yarn build:app && cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^1.15.0",
    "@pinia/nuxt": "^0.11.2",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "nuxt": "^4.0.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/uil": "^1.2.3",
    "postcss-html": "^1.8.1",
    "sass": "^1.89.2",
    "stylelint": "^16.22.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^7.0.2"
  }
}
